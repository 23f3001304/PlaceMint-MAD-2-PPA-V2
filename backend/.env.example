# Copy to `.env` and adjust. Never commit the real `.env`.
FLASK_ENV=development

# Secrets - change these in production.
SECRET_KEY=dev-secret-change-me
JWT_SECRET_KEY=dev-jwt-secret-change-me

# Database (SQLite). Leave blank to use backend/instance/ppa.db.
DATABASE_URL=

# Redis - install Memurai (Windows) / WSL / Docker. See README.
REDIS_URL=redis://localhost:6379/0
CACHE_REDIS_URL=redis://localhost:6379/1

# Pre-seeded admin (no admin registration exists).
ADMIN_EMAIL=admin@ppa.local
ADMIN_PASSWORD=admin123

# Email: `console` prints to the terminal; `smtp` sends real mail.
MAIL_BACKEND=console
MAIL_FROM=placement-cell@ppa.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# How many days before a deadline to start reminding students.
REMINDER_DEADLINE_DAYS=3
